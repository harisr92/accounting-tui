# Builds the app bundle signed with the upload key and uploads it to Google Play's internal
# track. Every value comes from COMPTER_* variables, which mobile-release.yml fills from
# repository secrets; app/README.md lists them.
require "tmpdir"

default_platform(:android)

# Play refuses a version code it has seen on any track, and builds uploaded by hand used the
# low ones (0.2.5 was 2), so the workflow's run number, which starts again at 1, can't be the
# version code. Take the one after the highest Play has; the run number only when Play can't
# be asked, or is higher.
def next_version_code(json_key, run_number)
  codes = %w[internal alpha beta production].flat_map do |track|
    google_play_track_version_codes(track: track, json_key_data: json_key)
  rescue StandardError => e
    UI.important("Couldn't read the #{track} track's version codes: #{e.message}")
    []
  end
  code = [codes.map(&:to_i).max.to_i + 1, run_number.to_i].max
  UI.message("Version code #{code} (Play's highest: #{codes.map(&:to_i).max || 'none'})")
  code.to_s
end

platform :android do
  desc "Build a signed app bundle and upload it to the internal testing track"
  lane :internal do
    # Without the upload key, android/app/build.gradle.kts signs with the debug key, which
    # Play rejects; say so here instead
    UI.user_error!("COMPTER_UPLOAD_STORE_FILE is not set") unless ENV["COMPTER_UPLOAD_STORE_FILE"]
    # Without it the app builds, but Google Drive sync can't sign in
    server_client_id = ENV["COMPTER_GOOGLE_SERVER_CLIENT_ID"].to_s
    UI.user_error!("COMPTER_GOOGLE_SERVER_CLIENT_ID is not set") if server_client_id.empty?
    build_name = ENV.fetch("COMPTER_BUILD_NAME")
    json_key = ENV.fetch("COMPTER_PLAY_SERVICE_ACCOUNT_JSON")
    build_number = next_version_code(json_key, ENV.fetch("COMPTER_BUILD_NUMBER"))

    # What's new in this build, from app/release-notes/<version>.txt. Play wants the notes
    # under the build number, known only now, so they are staged in a metadata folder of
    # their own; the listing itself is the metadata lane's
    notes = File.expand_path("../../release-notes/#{build_name}.txt", __dir__)
    UI.user_error!("#{notes} is missing: write #{build_name}'s release notes") unless File.exist?(notes)
    changelogs = File.join(Dir.mktmpdir, "en-US", "changelogs")
    FileUtils.mkdir_p(changelogs)
    FileUtils.cp(notes, File.join(changelogs, "#{build_number}.txt"))

    Dir.chdir("../..") do
      sh("flutter", "build", "appbundle", "--release",
         "--build-name=#{build_name}",
         "--build-number=#{build_number}",
         "--dart-define=COMPTER_GOOGLE_SERVER_CLIENT_ID=#{server_client_id}")
    end

    upload_to_play_store(
      track: "internal",
      aab: File.expand_path("../../build/app/outputs/bundle/release/app-release.aab", __dir__),
      json_key_data: json_key,
      # "draft" until Play has published the app once; then "completed"
      release_status: ENV.fetch("COMPTER_PLAY_RELEASE_STATUS", "draft"),
      metadata_path: File.dirname(File.dirname(changelogs)),
      skip_upload_metadata: true,
      skip_upload_changelogs: false,
      skip_upload_images: true,
      skip_upload_screenshots: true,
    )
  end

  # The listing lives in metadata/android: the text is kept in the repo, so the search
  # keywords are reviewed like code, and the images are drawn by
  # integration_test/screenshots_test.dart (see app/README.md). Play's current screenshots are
  # replaced by these
  desc "Upload the store listing text and images, without a build"
  lane :metadata do
    upload_to_play_store(
      json_key_data: ENV.fetch("COMPTER_PLAY_SERVICE_ACCOUNT_JSON"),
      metadata_path: File.expand_path("metadata/android", __dir__),
      skip_upload_aab: true,
      skip_upload_apk: true,
      skip_upload_changelogs: true,
      skip_upload_images: false,
      skip_upload_screenshots: false,
    )
  end
end
